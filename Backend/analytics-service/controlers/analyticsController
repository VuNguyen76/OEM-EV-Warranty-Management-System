const analyticsService = require('../services/analyticsService');

// UC24
exports.getFailureRate = async (req, res) => {
  try {
    const { model } = req.query; // Lấy ?model=VF8 từ URL
    const data = await analyticsService.getFailureStats(model);
    res.status(200).json({ success: true, data });
  } catch (error) {
    res.status(500).json({ success: false, message: error.message });
  }
};

